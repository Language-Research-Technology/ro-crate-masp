{
  "name": "ro-crate-masp",
  "version": "1.0.0",
  "description": "RO-Crate Machine Actionable Schemas and Profiles (MASP): the spec, as a MASP profile",
  "scripts": {
    "test": "mocha",
    "build": "npm run build:ro-crate-masp-profile",
    "build:ro-crate-masp-profile": "npm exec -- generate-masp-docs -x -- profiles/ro-crate-masp/profile-crate/ro-crate-metadata.json profiles/ro-crate-masp/profile-text.md profiles/ro-crate-masp/profile-crate/profile-documentation.md",
    "generate:mode:ro-crate-masp-profile": "npm exec -- generate-mode-file --output profiles/ro-crate-masp/profile-crate/crate-o-mode.json --update-profile profiles/ro-crate-masp/profile-crate/ro-crate-metadata.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Language-Research-Technology/ro-crate-masp.git"
  },
  "author": "ptsefton",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Language-Research-Technology/ro-crate-masp/issues"
  },
  "homepage": "https://github.com/Language-Research-Technology/ro-crate-masp#readme",
  "devDependencies": {
    "@crate-works/ro-crate-masp-tools": "^0.1.0",
    "chai": "^6.2.1",
    "mocha": "^11.7.5",
    "ro-crate": "^3.6.1"
  },
  "private": true
}
