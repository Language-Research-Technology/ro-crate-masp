' The MASPs group shared by the editing and deposit diagrams.
' Include after masp-style.iuml with:  !include masp-examples.iuml
' Defines: masps (the group)
'   schemas row:  m_org, m_ldact, m_dwc, m_prov
'   profiles row: m_ldac, m_wf, m_yours, m_masp
' Each diagram decides which row is on top, so the profiles face the arrows:
'   profiles on top:    m_ldac -[hidden]down- m_ldact
'   schemas on top:     m_ldact -[hidden]down- m_ldac

rectangle "<size:17><b>MASPs</b></size>\n<size:12><color:#4A6A8F><i>schemas and profiles, each an RO-Crate of machine-actionable rules</i></color></size>" <<masp>> as masps {
  rectangle "<b>Schema.org</b>\n<size:10><color:#2B7F9E>SCHEMA</color></size>" <<maspschema>> as m_org
  rectangle "<b>LDAC terms</b>\n<size:10><color:#2B7F9E>SCHEMA</color></size>" <<maspschema>> as m_ldact
  rectangle "<b>Darwin Core</b>\n<size:10><color:#2B7F9E>SCHEMA</color></size>" <<maspschema>> as m_dwc
  rectangle "<b>PROV-O</b>\n<size:10><color:#2B7F9E>SCHEMA</color></size>" <<maspschema>> as m_prov

  rectangle "<b>LDAC collection</b>\n<size:10><color:#4453C4>PROFILE</color></size>" <<maspprofile>> as m_ldac
  rectangle "<b>Workflow RO-Crate</b>\n<size:10><color:#4453C4>PROFILE</color></size>" <<maspprofile>> as m_wf
  rectangle "<b>Your profile</b>\n<size:10><color:#4453C4>PROFILE</color></size>" <<maspprofile>> as m_yours
  rectangle "<b>MASP profile</b>\n<size:10><color:#4453C4>PROFILE</color></size>" <<maspprofile>> as m_masp
}

' Each row in a single line
m_org -[hidden]right- m_ldact
m_ldact -[hidden]right- m_dwc
m_dwc -[hidden]right- m_prov
m_ldac -[hidden]right- m_wf
m_wf -[hidden]right- m_yours
m_yours -[hidden]right- m_masp
